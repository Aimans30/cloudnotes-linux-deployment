# Copy this file to .env and replace every CHANGE_ME / placeholder value.
# .env is git-ignored. Never commit real credentials.

# --- Application -----------------------------------------------------------
# Long random string used to sign session cookies and CSRF tokens.
# Generate one with: python scripts/generate_env.py  (or: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace_with_a_secure_random_secret
FLASK_ENV=production
GUNICORN_WORKERS=2

# --- PostgreSQL ------------------------------------------------------------
# Application connection string (must be PostgreSQL). Host "db" is the Compose service name.
DATABASE_URL=postgresql://cloudnotes_user:CHANGE_ME@db:5432/cloudnotes

# Password for the non-superuser application role. Must match the password in DATABASE_URL.
APP_DB_USER=cloudnotes_user
APP_DB_PASSWORD=CHANGE_ME

# Administrator account used only during initial setup of the database volume.
POSTGRES_ADMIN_USER=cloudnotes_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
